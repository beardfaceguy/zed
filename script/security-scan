#!/usr/bin/env bash

set -euo pipefail

advisory=0
if [[ "${1:-}" == "--advisory" ]]; then
    advisory=1
    shift
fi
if (( $# > 0 )); then
    printf 'Usage: %s [--advisory]\n' "${0##*/}" >&2
    exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

require_tool() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'security-scan: required tool `%s` is not installed; run ./script/install-hooks for setup instructions\n' "$1" >&2
        exit 2
    fi
}

require_tool semgrep
require_tool osv-scanner

if command -v timeout >/dev/null 2>&1; then
    timeout_command=timeout
elif command -v gtimeout >/dev/null 2>&1; then
    timeout_command=gtimeout
else
    printf 'security-scan: required tool `timeout` or `gtimeout` is not installed\n' >&2
    exit 2
fi

run_with_timeout() {
    local duration="$1"
    shift
    "$timeout_command" --foreground "$duration" "$@"
}

git_dir="$(git rev-parse --git-dir)"
[[ "$git_dir" == /* ]] || git_dir="$repo_root/$git_dir"
report_dir="$git_dir/security-reports"
mkdir -p "$report_dir"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
semgrep_report="$report_dir/semgrep-$timestamp.json"
semgrep_log="$report_dir/semgrep-$timestamp.log"
osv_report="$report_dir/osv-$timestamp.json"
osv_log="$report_dir/osv-$timestamp.log"

printf 'security-scan: running Semgrep; reports: %s and %s\n' "$semgrep_report" "$semgrep_log"
semgrep_rc=0
run_with_timeout "${SEMGREP_SCAN_TIMEOUT:-15m}" semgrep scan \
    --config p/rust \
    --config p/python \
    --config p/javascript \
    --error \
    --quiet \
    --jobs 1 \
    --metrics off \
    --json-output "$semgrep_report" \
    --exclude target \
    --exclude graphify-out \
    --exclude 'docs/theme/c15t@2.0.0-rc.3.js' \
    --exclude 'crates/agent/src/tools/evals/fixtures' \
    . > "$semgrep_log" 2>&1 || semgrep_rc=$?

printf 'security-scan: running OSV-Scanner; reports: %s and %s\n' "$osv_report" "$osv_log"
osv_rc=0
run_with_timeout "${OSV_SCAN_TIMEOUT:-5m}" osv-scanner scan source \
    --recursive \
    --verbosity=error \
    --format=json \
    --output-file "$osv_report" \
    . > "$osv_log" 2>&1 || osv_rc=$?

if (( semgrep_rc > 1 )); then
    printf 'security-scan: Semgrep failed to execute correctly (exit %d)\n' "$semgrep_rc" >&2
    tail -n 40 "$semgrep_log" >&2
    exit "$semgrep_rc"
fi
if (( osv_rc > 1 )); then
    printf 'security-scan: OSV-Scanner failed to execute correctly (exit %d)\n' "$osv_rc" >&2
    tail -n 40 "$osv_log" >&2
    exit "$osv_rc"
fi

if (( semgrep_rc == 1 || osv_rc == 1 )); then
    if (( advisory == 1 )); then
        printf 'security-scan: findings detected; advisory mode does not block this push\n' >&2
        printf 'security-scan: set ENFORCE_SECURITY_SCAN=1 after the existing baselines are triaged\n' >&2
        exit 0
    fi
    printf 'security-scan: findings detected; inspect reports under %s\n' "$report_dir" >&2
    exit 1
fi

printf 'security-scan: no findings\n'
